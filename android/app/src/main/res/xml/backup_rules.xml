<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- The device token is a bearer secret for this personal backend - keep
         it out of auto backup so it never lands in an unrelated Google
         account's backup storage. -->
    <exclude domain="file" path="datastore/jarvis_settings.preferences_pb" />
    <exclude domain="database" path="." />
</full-backup-content>
