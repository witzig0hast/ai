# Copy to .env and adjust. See ../docs/architecture.md for the full contract.

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEVICE_TOKENS=change-me-device-token-1,change-me-device-token-2

# --- Ollama (native install on this host, NOT docker) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:70b

# --- Storage ---
DATABASE_URL=sqlite:///./data/jarvis.db
UPLOAD_DIR=./data/uploads

# --- STT (faster-whisper) ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
# Tesla P40 = Pascal, no fast fp16 -> int8_float32 is the safe default.
WHISPER_COMPUTE_TYPE=int8_float32

# --- TTS (Coqui XTTS-v2) ---
XTTS_MODEL_NAME=tts_models/multilingual/multi-speaker/xtts_v2
XTTS_DEVICE=cuda
XTTS_DEFAULT_LANGUAGE=de
# Directory containing per-agent reference wav files for voice cloning,
# named <voice_id>.wav (see Agent.voice_id in docs/architecture.md)
XTTS_SPEAKER_SAMPLES_DIR=./data/voices

# --- Home Assistant (feature-flagged off by default, see docs/architecture.md §8) ---
HOME_ASSISTANT_ENABLED=false
HOME_ASSISTANT_BASE_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# --- n8n (feature-flagged off by default) ---
N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_TOKEN=

# --- Standort (Wetter-Tool + Briefing, Open-Meteo braucht keinen API-Key) ---
# Leer lassen = Wetter-Feature bleibt inaktiv.
HOME_LATITUDE=
HOME_LONGITUDE=
TIMEZONE=Europe/Berlin

# --- Reminder ---
REMINDER_POLL_INTERVAL_SECONDS=15
